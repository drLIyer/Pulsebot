{
  "manifest_version": 3,
  "name": "Pulsebot",
  "description": "Chat with LinkedIn newsletter archives, powered by Pulsebot",
  "version": "1.0.0",

  "permissions": ["storage"],
  "host_permissions": ["*://*/*"],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Pulsebot Chat",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },

  "background": {
    "service_worker": "background.js"
  }
}
